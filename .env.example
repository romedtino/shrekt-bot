# Discord Bot Token (required)
SHREKT_DISCORD_TOKEN=your_bot_token_here

# Discord API Key (for bot-conglomorate service)
SHREKT_KEY=your_api_key_here

# Guild/Server IDs (required)
SHREKT_GUILD_ID=your_guild_id_here
JPL_GUILD_ID=your_other_guild_id_here

# Bot Conglomorate Service URL
CONGO_URL=https://your-congo-service-url.com/

# Optional: Test Guild ID (for development)
TEST_GUILD_ID=your_test_guild_id_here
